				type: "xp"
				xp: 100
			}]
			subtitle: "「封弓」"
			tasks: [{
				id: "20859E0353C0CE86"
				item: {
					Count: 1
					id: "minecraft:bow"
					tag: {
						Damage: 0
						Enchantments: [{
							id: "minecraft:infinity"
							lvl: 1s
